# Copie para .env (nesta pasta) para mudar alguma configuração.
# Porta da API local
PORT=34600
# Arquivo do banco SQLite (relativo à raiz do projeto)
DB_PATH=apps/server/data/game.db
# Pasta com as sprites (subpastas pokemon/, items/, types/).
# Padrão: as sprites já baixadas pela versão anterior, na pasta vizinha.
ASSETS_DIR=../PokemonSimulator Sqlite/backend/public
